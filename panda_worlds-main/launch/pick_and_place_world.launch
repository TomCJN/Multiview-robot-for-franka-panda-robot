<launch>
    <include file="$(find franka_gazebo)/launch/panda.launch">
        <arg name="use_gripper" value="true"/>
        <!-- arg name="use_pump" value="false"/ -->
        <arg name="x" value="0."/>
        <arg name="z" value="0.06"/>
        <arg name="world" value="$(find panda_worlds)/worlds/pick-and-place.sdf"/>
        <arg name="controller" value="position_joint_trajectory_controller"/>
        <arg name="rviz" value="false"/>
    </include>

    <arg name="use_gazebo2tf" default="false" />
    <include if="$(arg use_gazebo2tf)" file="$(find gazebo2rviz)/launch/gazebo2tf.launch"/> <!-- This publishes all objects in gazebo as tf frames. Useful to fake perception. -->
</launch>
